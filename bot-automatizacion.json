    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "id"
        },
        "text": "Esta imagen debería ser un récipe u orden médica de exámenes de laboratorio. Transcribe únicamente los nombres de los exámenes solicitados, separados por comas. Si la imagen no contiene exámenes de laboratorio o no se puede leer, responde exactamente: NINGUNO",
        "inputType": "base64",
        "options": {
          "detail": "high",
          "maxTokens": 500
        }
      },
      "id": "b135ab48-e66e-489f-ae06-25a7ce4101fe",
      "name": "Leer récipe",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        80,
        192
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Buscar el texto que devolvió la IA al leer la imagen (sin importar la forma de la respuesta)\nconst textos = [];\nconst walk = (o) => {\n  if (!o || typeof o !== 'object') return;\n  if (Array.isArray(o)) { o.forEach(walk); return; }\n  if (o.type === 'output_text' && typeof o.text === 'string') textos.push(o.text);\n  Object.values(o).forEach(v => { if (v && typeof v === 'object') walk(v); });\n};\nwalk(item);\n\n// Si es mensaje de texto usa el texto; si es imagen usa lo leído por la IA\nlet consulta = (item.message && item.message.text) ? item.message.text : textos.join(', ');\n\n// Agregar el texto que el cliente escribió debajo de la foto, si existe\nconst trigger = $('Telegram Trigger').first().json;\nconst caption = (trigger.message && trigger.message.caption) ? trigger.message.caption : '';\n\nconsulta = [consulta, caption].join(' ').replace(/NINGUNO/gi, '').trim();\n\nreturn [{ json: { consulta } }];"
      },
      "id": "9b247598-c13a-4ae1-b94a-6f4b7a60364a",
